<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RahaHaldur.Views.SortPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RahaHaldur.ViewModels"
             xmlns:loc="clr-namespace:RahaHaldur.Resources.Localization"
             Title="{loc:Translate Sort}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <Label Grid.Row="0" Text="{loc:Translate SortHint}" StyleClass="Muted" />

        <!-- Neli kategooriat, mille peale saab kulu visata (DropGestureRecognizer) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="100,100" ColumnSpacing="12" RowSpacing="12">

            <Border Grid.Row="0" Grid.Column="0" StyleClass="Card">
                <Border.GestureRecognizers>
                    <DropGestureRecognizer DropCommand="{Binding DropCommand}" DropCommandParameter="Food" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{loc:Translate Cat_Food}" StyleClass="Title" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" StyleClass="Card">
                <Border.GestureRecognizers>
                    <DropGestureRecognizer DropCommand="{Binding DropCommand}" DropCommandParameter="Transport" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{loc:Translate Cat_Transport}" StyleClass="Title" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" StyleClass="Card">
                <Border.GestureRecognizers>
                    <DropGestureRecognizer DropCommand="{Binding DropCommand}" DropCommandParameter="Fun" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{loc:Translate Cat_Fun}" StyleClass="Title" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" StyleClass="Card">
                <Border.GestureRecognizers>
                    <DropGestureRecognizer DropCommand="{Binding DropCommand}" DropCommandParameter="Other" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{loc:Translate Cat_Other}" StyleClass="Title" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Kulud, mida saab lohistada (DragGestureRecognizer) -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Expenses}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="{loc:Translate Empty}" StyleClass="Muted"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StyleClass="Card">
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer
                                DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:SortViewModel}}, Path=DragStartCommand}"
                                DragStartingCommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Grid.Column="0" Source="expense.png" WidthRequest="32" HeightRequest="32" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" StyleClass="Title" />
                                <Label Text="{Binding CategoryText}" StyleClass="Muted" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding AmountText}" StyleClass="Value"
                                   TextColor="{StaticResource ExpenseColor}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
