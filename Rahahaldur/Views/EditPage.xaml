<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RahaHaldur.Views.EditPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:RahaHaldur.Resources.Localization"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border StyleClass="Card">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Translate TitleLabel}" StyleClass="Muted" />
                    <Entry Text="{Binding Title}" Placeholder="{loc:Translate TitleHint}" />

                    <Label Text="{loc:Translate Amount}" StyleClass="Muted" Margin="0,8,0,0" />
                    <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="{loc:Translate AmountHint}" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="{loc:Translate IsIncome}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsIncome}" />
                    </Grid>

                    <!-- Kategooria on vajalik ainult kulude puhul -->
                    <VerticalStackLayout IsVisible="{Binding IsExpense}" Spacing="6" Margin="0,8,0,0">
                        <Label Text="{loc:Translate Category}" StyleClass="Muted" />
                        <Picker ItemsSource="{Binding CategoryNames}" SelectedIndex="{Binding CategoryIndex}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="{loc:Translate Save}" StyleClass="Primary" Command="{Binding SaveCommand}" />
            <Button Text="{loc:Translate Cancel}" StyleClass="Secondary" Command="{Binding CancelCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
